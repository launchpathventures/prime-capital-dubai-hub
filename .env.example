# =============================================================================
# CATALYST - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it contains secrets.
#
# Naming convention:
#   NEXT_PUBLIC_*  = Exposed to browser (safe for public values only)
#   No prefix      = Server-only (safe for secrets)
# =============================================================================

# -----------------------------------------------------------------------------
# App Settings
# -----------------------------------------------------------------------------

# Base URL of the application (used for auth redirects, SEO, etc.)
# Leave unset for local development (defaults to http://localhost:3000)
# Set to your production URL when deploying
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Multi-Brand Override (Development Only)
# -----------------------------------------------------------------------------

# Force a specific brand surface in development, bypassing hostname detection.
# In production, brand is resolved from the request hostname (see lib/brand.ts).
# Use this to preview the Tahir surface at http://localhost:3000 without DNS.
# Values: "primecapital" (default) | "tahir"
NEXT_PUBLIC_BRAND_OVERRIDE=

# -----------------------------------------------------------------------------
# Documentation Access
# -----------------------------------------------------------------------------

# Show docs in production? (true/false)
# When false, /docs routes return 404 in production builds.
NEXT_PUBLIC_DOCS_ENABLED="true"

# -----------------------------------------------------------------------------
# Root Redirect (Development Toggle)
# -----------------------------------------------------------------------------

# Redirect the root URL "/" to a different path during development.
# Useful when the website isn't ready but you want to demo another surface.
# Examples: "/learn", "/app", "/docs"
# Leave empty or unset to use the web surface as the homepage.
NEXT_PUBLIC_ROOT_REDIRECT=

# Optional password to protect docs in production.
# Leave empty for no password protection.
# When set, users must enter this password to access /docs.

# -----------------------------------------------------------------------------
# Developer Tools
# -----------------------------------------------------------------------------

# Enable/disable dev tools cards throughout the app
# Set to "false" to hide all dev tools
NEXT_PUBLIC_DEV_TOOLS=

# Only show dev tools in development mode (ignores DEV_TOOLS flag in production)
# Set to "true" to hide dev tools in production regardless of DEV_TOOLS setting
NEXT_PUBLIC_DEV_TOOLS_DEV_ONLY=

# -----------------------------------------------------------------------------
# Third-Party Services (add as needed)
# -----------------------------------------------------------------------------

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Google Workspace SSO
# Configure in Supabase Dashboard > Authentication > Providers > Google:
# 1. Create OAuth 2.0 credentials in Google Cloud Console (set as "Internal" for workspace-only)
# 2. Set redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
# 3. Enter Client ID + Secret in Supabase Dashboard
# No env vars needed here — Supabase handles the Google credentials

# Supabase (server-only - NEVER expose to client)
# Required for: account deletion
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# AUTH_MODE - Explicitly set the auth mode (optional)
# 
# Values: "demo" | "password" | "supabase" | "custom"
#
# When set, this overrides auto-detection. Useful when:
# - You use Supabase for data but want simple password auth
# - Testing different auth modes without changing other env vars
# - Forcing demo mode in development
#
# When not set, mode is auto-detected:
#   custom   → if AUTH_CUSTOM_ENDPOINT is set
#   supabase → if Supabase URL + key are set
#   password → if AUTH_PASSWORD is set
#   demo     → fallback (accepts any credentials)
#
AUTH_MODE=

# Password for "password" mode
AUTH_PASSWORD=

# Default password for new users created via admin panel (server-only, never expose to client)
# This is used when admins create new user accounts
AUTH_DEFAULT_PASSWORD=

# API endpoint for "custom" mode
AUTH_CUSTOM_ENDPOINT=

# Example: Database connection
# DATABASE_URL=""

# Example: Analytics
# NEXT_PUBLIC_ANALYTICS_ID=""

# -----------------------------------------------------------------------------
# AI Coach (Anthropic Claude)
# -----------------------------------------------------------------------------

# Anthropic API key for AI Coach feature
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model — default for platform features (coach, essentials, etc.)
CLAUDE_MODEL=claude-sonnet-4-20250514
# Claude model — for YouTube script generation (higher quality)
YOUTUBE_SCRIPT_MODEL=claude-opus-4-20250514

# Perplexity API — for live web-search-backed topic suggestions
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# -----------------------------------------------------------------------------
# Lead Capture
# -----------------------------------------------------------------------------

# Zapier webhook URL for lead form submissions
# Get from: Zapier → Create Zap → Trigger: Webhooks by Zapier → Catch Hook
ZAPIER_LEAD_WEBHOOK_URL=
# Zapier webhook URL for returning lead submissions (with Bitrix Lead ID)
ZAPIER_BID_WEBHOOK_URL=
# Zapier webhook URL for general events (certificate issuance, etc.)
ZAPIER_WEBHOOK_URL=

# Calendly scheduling URL (for contact form scheduling step)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/tahirmajithia/30min

# Ahmed Ashfaq funnel placeholders
# Leave empty to use the main Prime Capital placeholders until Ahmed-specific
# assets are ready.
NEXT_PUBLIC_AHMED_CALENDLY_URL=
NEXT_PUBLIC_AHMED_STRATEGY_KIT_URL=

# -----------------------------------------------------------------------------
# AgentCRM (Property Feed + Inline Enquiry Widget)
# -----------------------------------------------------------------------------
# The CRM is the source of truth for property listings, pricing, and lead
# capture on PDPs. The marketing site reads from the public property API and
# embeds the CRM enquiry widget inline on every property detail page.

# Public base URL of the CRM (no trailing slash). Used both server-side
# (API fetches) and client-side (iframe origin + postMessage validation).
NEXT_PUBLIC_CRM_BASE_URL=https://crm.primecapitaldubai.com

# Stable agency UUID for prime-capital. Tim provides; do NOT use the slug.
# Required by the property API and widget iframe URL.
NEXT_PUBLIC_CRM_AGENCY_UUID=

# AgentCRM public enquiry endpoint (server-side POST).
# Used by /api/leads to forward non-PDP form submissions.
# Get the API key from CRM Admin Settings → API keys (format: eak_ + 32 hex chars).
# Server-only — never expose to the client.
AGENTCRM_API_URL=https://crm.primecapitaldubai.com/api/public/enquiry
AGENTCRM_API_KEY=

# -----------------------------------------------------------------------------
# ElevenLabs TTS (Audio Generation)
# -----------------------------------------------------------------------------

# ElevenLabs API key for text-to-speech
# Get from: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# Voice ID for audio generation (optional, defaults to Fahco4VZzobUeiPqni1S)
ELEVENLABS_VOICE_ID=Fahco4VZzobUeiPqni1S

# TTS model (optional, defaults to eleven_multilingual_v2)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# -----------------------------------------------------------------------------
# Deepgram Speech-to-Text
# -----------------------------------------------------------------------------

# Deepgram API key for voice input transcription
# Get from: https://console.deepgram.com/
DEEPGRAM_API_KEY=
# Mapbox (Static Maps)
NEXT_PUBLIC_MAPBOX_TOKEN=

# -----------------------------------------------------------------------------
# Error Tracking (Sentry)
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking
# Get from: Sentry Dashboard -> Settings -> Client Keys (DSN)
# Server-side DSN (API routes, server components)
SENTRY_DSN=

# Client-side DSN (browser errors) - MUST start with NEXT_PUBLIC_
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Unsplash API
# -----------------------------------------------------------------------------

# Unsplash API credentials for image search
# Get from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# -----------------------------------------------------------------------------
# Sync API (External Service Access)
# -----------------------------------------------------------------------------

# API key for external services to query users and team data
# Generate a strong random key: openssl rand -hex 32
# Used by: GET /api/sync/team, GET /api/sync/users
SYNC_API_KEY=

# Vercel Cron secret (auto-set by Vercel, or generate: openssl rand -hex 32)
# Used by: /api/cron/team-sync
CRON_SECRET=
